rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if signedInAs(uid);
      allow create, update: if signedInAs(uid);
      allow delete: if false;

      match /lessons/{lessonId} {
        // `request.resource` exists only on writes. Using it in a read rule
        // denies the owner's own get/list.
        allow read: if signedInAs(uid);
        allow create, update: if signedInAs(uid) && request.resource.data.ownerUid == uid;
        allow delete: if signedInAs(uid) && resource.data.ownerUid == uid;
        match /scenes/{sceneId} {
          allow read, write: if signedInAs(uid);
        }
      }

      match /whiteboards/{boardId} {
        allow read: if signedInAs(uid);
        allow create, update: if signedInAs(uid)
          && request.resource.data.ownerUid == uid
          && request.resource.data.keys().hasOnly(['version', 'ownerUid', 'lessonId', 'pageOrder', 'activePageId', 'updatedAt'])
          && request.resource.data.pageOrder is list
          && request.resource.data.pageOrder.size() > 0
          && request.resource.data.pageOrder.size() <= 100;
        allow delete: if signedInAs(uid) && resource.data.ownerUid == uid;

        match /pages/{pageId} {
          allow read: if signedInAs(uid);
          // Strokes are one JSON string. string.size() is the cap rules can
          // actually enforce; request.resource.size() allowed a ~950 KB field.
          allow create, update: if signedInAs(uid)
            && request.resource.data.ownerUid == uid
            && request.resource.data.keys().hasOnly(['version', 'ownerUid', 'payload'])
            && request.resource.data.payload is string
            && request.resource.data.payload.size() < 800000;
          allow delete: if signedInAs(uid) && resource.data.ownerUid == uid;
        }
      }

      match /settings/{settingId} {
        // Provider preferences are managed by trusted server routes together
        // with credential state; clients do not write these documents.
        allow read, write: if false;
      }

      match /providerCredentials/{providerId} {
        // Ciphertext is server-only defense in depth. Browser SDK access is
        // denied even to the owning user.
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
